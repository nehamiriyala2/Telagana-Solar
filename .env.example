# ───────── Site ─────────
NEXT_PUBLIC_SITE_URL=https://www.example.com          # [EDIT] your domain
NEXT_PUBLIC_PHONE=+91XXXXXXXXXX                        # [EDIT] shown on site, "Call" buttons
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX               # [EDIT] WhatsApp chat number (no +)
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com            # [EDIT]

# ───────── Lead storage (use one or both) ─────────
# Google Sheets / Zapier / Make / n8n webhook (see automation/google-sheets-apps-script.gs)
LEAD_WEBHOOK_URL=                                      # [EDIT]
LEAD_WEBHOOK_SECRET=                                   # [EDIT] any long random string
# Supabase (needed for the 1-hour "not called" reminders). Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=                             # server only, never NEXT_PUBLIC

# ───────── Owner notifications ─────────
OWNER_WHATSAPP_NUMBER=91XXXXXXXXXX                     # [EDIT] who gets lead alerts
OWNER_EMAIL=owner@example.com                          # [EDIT]
RESEND_API_KEY=                                        # email via resend.com
EMAIL_FROM=Telangana Solar <leads@yourdomain.com>      # [EDIT] verified sender

# ───────── WhatsApp Cloud API (Meta) ─────────
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Approved message templates (Meta Business Manager → WhatsApp → Message templates)
WHATSAPP_TEMPLATE_OWNER_ALERT=                         # e.g. lead_alert  (3 body variables)
WHATSAPP_TEMPLATE_CUSTOMER_REPLY=                      # e.g. lead_thanks (2 body variables), create en + te versions
WHATSAPP_TEMPLATE_LANG=en

# ───────── Follow-up ─────────
LEAD_ACTION_SECRET=                                    # signs "Mark as called" links
CRON_SECRET=                                           # protects /api/cron/lead-reminders

# ───────── Tracking ─────────
NEXT_PUBLIC_GA4_ID=                                    # G-XXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=                             # AW-XXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=                     # conversion label for form submits
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=                 # conversion label for WhatsApp clicks

# ───────── Admin dashboard (MySQL on XAMPP) ─────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=telangana_solar
AUTH_SECRET=                                           # long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_FIRST_EMAIL=                                     # [EDIT] first admin (npm run admin:create)
ADMIN_DEV_CODE=                                        # optional: fixed sign-in code for `npm run dev` only (ignored in production or when SMTP is set)
# Sign-in codes are emailed via SMTP. Left empty in development, the code is printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Telangana Solar <no-reply@yourdomain.com>
